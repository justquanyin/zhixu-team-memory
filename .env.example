# Node >= 22. Copy to .env; npm scripts load it automatically.
HOST=127.0.0.1
PORT=4317
APP_ORIGIN=http://127.0.0.1:4317
# Empty = durable embedded PostgreSQL (PGlite). Only one app process per directory.
DATABASE_URL=
PGLITE_DIR=.runtime/database
# Empty = randomly generated password, saved with mode 0600 in .runtime/admin-password.txt
ADMIN_PASSWORD=
# Opt in only on a NEW disposable database to load synthetic demo records.
SEED_DEMO=false
COOKIE_SECURE=false
# Offline by default. Explicit opt-in sends REDACTED event text to this provider.
EXTRACTOR=rules
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# MCP stdio connects to the same application; create a token in Members UI.
MEMORY_API_URL=http://127.0.0.1:4317
MEMORY_API_TOKEN=
